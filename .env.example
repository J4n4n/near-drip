# Testnet only. NEVER commit real keys — copy to `.env` and keep key files
# under `.near-credentials/` (gitignored).
CONTRACT_ID=drip-treasury-2026.testnet
OWNER_ACCOUNT_ID=drip-treasury-2026.testnet
PAYEE_ACCOUNT_ID=drip-payee-2026.testnet
OWNER_KEY_PATH=.near-credentials/treasury.json
AGENT_KEY_PATH=.near-credentials/agent-key.json
ONECLICK_URL=https://1click.chaindefuser.com/v0/quote
# Optional. Rules engine is the fallback when empty.
NEAR_AI_API_KEY=
AGENT_PORT=3001
VITE_CONTRACT_ID=drip-treasury-2026.testnet
VITE_AGENT_URL=http://localhost:3001
# Optional. Defaults to https://rpc.testnet.near.org.
NEAR_RPC_URL=https://rpc.testnet.near.org
